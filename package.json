{
  "name": "mropenvpn-client-windows",
  "version": "1.2.0",
  "description": "MrOpenVPN Client for Windows - a desktop OpenVPN client with the same interface as the Android app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron tests/unit.js",
    "test:engine": "electron tests/engine.js",
    "test:audit": "electron tests/comprehensive_audit.js",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "build:win": "electron-builder --win",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:native:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1 -SelfContained"
  },
  "build": {
    "appId": "com.mr712.mropenvpn",
    "productName": "MrOpenVPNClient",
    "compression": "maximum",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
  {
    "from": "scripts/install-service.ps1",
    "to": "scripts/install-service.ps1"
  },
  {
    "from": "scripts/uninstall-service.ps1",
    "to": "scripts/uninstall-service.ps1"
  }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-${version}-setup.exe"
    }
  },
  "author": "Mr712",
  "license": "GPL-3.0",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "electron": "33.2.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
